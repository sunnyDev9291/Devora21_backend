generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  LOCAL
  GOOGLE
  MICROSOFT
}

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  passwordHash  String?
  firstName     String?
  lastName      String?
  avatarStorageKey String?
  avatarUrl     String?
  provider      AuthProvider @default(LOCAL)
  providerId    String?
  emailVerified Boolean      @default(false)
  resumeBuilderEnabled Boolean @default(false)
  /** Super Admin console — required for /admin/* APIs. */
  isSuperAdmin Boolean @default(false)
  /**
   * Per–Super Admin operator gateway (FE /super-admin second gate).
   * Username unique when set; password stored as bcrypt hash only.
   */
  gatewayUsername         String?   @unique @map("gateway_username")
  gatewayPasswordHash     String?   @map("gateway_password_hash")
  gatewayCredentialsSetAt DateTime? @map("gateway_credentials_set_at")
  onboardingCompleted Boolean @default(false)
  /** Active stored resume template id (`tpl_…`). */
  resumeTemplateId       String?
  resumeTemplateKey  String?
  resumeTemplateFileName String?
  promptFileKey      String?
  promptFileName     String?
  customPrompt       String?  @db.Text
  /** Per-user job crawl listing URLs keyed by platform (builtin, hiringcafe, workable, workingnomads). */
  listingUrls        Json?    @map("listing_urls")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  refreshTokens          RefreshToken[]
  passwordResetTokens    PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  resumeArchives         ResumeArchive[]
  resumeTemplates        ResumeTemplate[]
  apiKeys                ApiKey[]
  resumeGenerationJobs   ResumeGenerationJob[]
  remoteDevices          RemoteDevice[]
  resumeRemoteDeliveries ResumeRemoteDelivery[]
  applicationQaSessions  ApplicationQaSession[]

  @@unique([provider, providerId])
  @@index([email])
  @@index([resumeTemplateId])
}

/**
 * One Chrome tab recording session for job-application Q&A capture.
 * Extension upserts by (userId, tabSessionId); Super Admin reads across owners.
 */
model ApplicationQaSession {
  id            String   @id @default(uuid())
  userId        String
  /** Client-generated id stable for the life of one browser tab session. */
  tabSessionId  String   @map("tab_session_id")
  tabUrl        String   @map("tab_url") @db.Text
  pageTitle     String?  @map("page_title")
  status        String   @default("recording") // recording | paused | deleted
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastSyncedAt  DateTime @default(now()) @map("last_synced_at")

  user  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ApplicationQaItem[]

  @@unique([userId, tabSessionId])
  @@index([userId, updatedAt(sort: Desc)])
  @@index([status, updatedAt(sort: Desc)])
  @@map("application_qa_sessions")
}

model ApplicationQaItem {
  id          String   @id @default(uuid())
  sessionId   String   @map("session_id")
  /**
   * Stable element key within a session (DOM identity — not a human "question").
   * Column name kept as question_key for backward-compatible DB mapping.
   */
  questionKey String   @map("question_key")
  /** Human-readable element summary (tag/type/#id/[name]). */
  question    String   @db.Text
  /** Current input value for this element. */
  answer      String   @db.Text
  fieldType   String?  @map("field_type")
  /** DOM event that last updated this row: input | change | click | blur */
  eventType   String?  @map("event_type")
  cssSelector String?  @map("css_selector") @db.Text
  elementTag  String?  @map("element_tag")
  elementId   String?  @map("element_id")
  elementName String?  @map("element_name")
  elementClass String? @map("element_class") @db.Text
  /** Selected attributes snapshot (JSON object). */
  attributes  Json?
  /** Client event time (ms epoch or ISO stored as DateTime). */
  occurredAt  DateTime? @map("occurred_at")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  session ApplicationQaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionKey])
  @@index([sessionId])
  @@index([sessionId, occurredAt])
  @@map("application_qa_items")
}

/** Original DOCX resume template uploaded by the user (source of truth for fill/render). */
model ResumeTemplate {
  id          String   @id
  userId      String
  fileName    String
  storageKey  String
  /** SHA-256 of DOCX bytes — used for PDF cache keys / change detection. */
  contentHash String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([userId])
  @@map("resume_templates")
}

model ApiKey {
  id         String    @id @default(uuid())
  userId     String
  name       String
  keyPrefix  String
  keyHash    String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}

model ResumeArchive {
  id             String   @id @default(uuid())
  userId         String
  /** Template used to generate this archive (`tpl_…`), if known. */
  templateId     String?
  bidAt          DateTime
  jobTitle       String
  companyName    String
  jobDescription String?  @db.Text
  resumeFileName String
  pdfFileName    String
  /** Deprecated: files live on Backblaze; nullable for old rows. */
  docxStorageKey String?
  /** Deprecated: PDFs live on Backblaze; nullable for old rows. */
  pdfStorageKey  String?
  /** Backblaze DOCX download URL. */
  docxUrl        String?  @db.Text
  /** Backblaze PDF download URL. */
  pdfUrl         String?  @db.Text
  /**
   * How the resume was generated.
   * web_ui = POST /resume/render or /resume/archive
   * one_click_api = POST /resume/from-job pipeline
   */
  generationMethod String @default("web_ui")
  /**
   * Interview rounds recorded on intentional Round-N downloads.
   * JSON array: [{ "round": 1, "downloadedAt": "ISO-8601" }, ...]
   * "Other" downloads do not append here.
   */
  interviewHistory Json? @map("interview_history")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries ResumeRemoteDelivery[]

  @@index([bidAt(sort: Desc)])
  @@index([userId, bidAt(sort: Desc)])
  @@index([generationMethod, bidAt(sort: Desc)])
  @@index([userId, companyName])
  @@index([userId, jobTitle])
  @@index([templateId])
  @@map("resume_archives")
}

/** A remote PC that can pull queued resume downloads (Windows agent). */
model RemoteDevice {
  id           String    @id @default(uuid())
  userId       String
  name         String
  secretPrefix String
  secretHash   String    @unique
  isDefault    Boolean   @default(false)
  lastSeenAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries ResumeRemoteDelivery[]

  @@index([userId])
  @@map("remote_devices")
}

/**
 * Queued file delivery to a remote device.
 * status: pending | claimed | delivered | failed | expired
 */
model ResumeRemoteDelivery {
  id          String    @id @default(uuid())
  userId      String
  deviceId    String
  archiveId   String
  status      String    @default("pending")
  includePdf  Boolean   @default(true)
  includeDocx Boolean   @default(true)
  error       String?
  claimedAt   DateTime?
  deliveredAt DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  device  RemoteDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  archive ResumeArchive @relation(fields: [archiveId], references: [id], onDelete: Cascade)

  @@index([deviceId, status, createdAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([archiveId])
  @@map("resume_remote_deliveries")
}

model ResumeGenerationJob {
  id          String   @id @default(uuid())
  userId      String
  url         String
  status      String
  message     String?
  warning     String?
  error       String?
  archiveId   String?
  jobTitle    String?
  companyName String?
  resumeName  String?
  pdfFileName String?
  pdfUrl      String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("resume_generation_jobs")
}

model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique
  userId     String
  expiresAt  DateTime
  /** When true, refresh slides a 30-day cookie window. */
  rememberMe Boolean  @default(false) @map("remember_me")
  createdAt  DateTime @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}
