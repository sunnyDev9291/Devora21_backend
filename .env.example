# Server
NODE_ENV=production
PORT=5000

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/devora21

# JWT secrets (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=change-me-to-a-random-string-at-least-32-chars-long
JWT_REFRESH_SECRET=change-me-to-another-random-string-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Primary frontend (email links, server-side OAuth fallbacks)
FRONTEND_URL=https://devora21-dev.netlify.app
# Additional allowed origins for CORS + OAuth (comma-separated)
FRONTEND_URLS=https://devora21.com,https://www.devora21.com

# API base URL used for OAuth callback URLs
# Current VPS IP:
API_BASE_URL=http://31.44.7.64:5000
# When HTTPS domain is ready, switch to:
# API_BASE_URL=https://api.devora21.com

# Cookie domain (optional)
# Leave empty when using raw IP. Set when using a shared parent domain:
# COOKIE_DOMAIN=.devora21.com

# Google OAuth
# Callback: {API_BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LibreOffice (DOCX -> PDF for resume archive)
LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe

# SMTP (optional — emails log to console when not configured)
# Resend example (verify devora21.com domain to email any user):
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_your_api_key
# SMTP_FROM=noreply@devora21.com
# Note: onboarding@resend.dev only delivers to your Resend account email until domain is verified.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@devora21.com

# Set true to skip auth rate limiting (useful while developing locally).
DISABLE_RATE_LIMIT=false

# Email verification. false = paused; signup users can log in without verifying.
REQUIRE_EMAIL_VERIFICATION=false

# Resume archive
STORAGE_DIR=storage
RESUME_MAX_FILE_SIZE_BYTES=10485760
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe

# Claude AI proxy (server-side only — never expose to browser/Netlify client)
CLAUDE_API_KEY=
# Set true to mock /ai chat responses (fast local resume testing, no Claude calls)
AI_MOCK=false
# Shared secret for Netlify server-to-server AI calls (required in production)
# User-facing API keys are created via POST /auth/api-keys (prefix dv21_)
AI_INTERNAL_API_KEY=

# Job Check stream (POST /jobs/check/stream)
# Optional override. If unset, uses the crafted default in src/lib/job-check/prompt.ts
# (LATAM engineer fit: English working language OR USD pay).
# JOB_CHECK_SYSTEM_PROMPT=

# DeepSeek (normalizes Zyte scrape → companyName/jobTitle/jobDescription)
DEEPSEEK_API_KEY=

# Zyte (job link scrape — POST /jobs/scrape)
ZYTE_API_KEY=

# Backblaze B2 — PDF hosting for POST /resume/from-job
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=tiger-builder
# false = friendly public URL https://fXXX.backblazeb2.com/file/<bucket>/<key>
# true  = S3 presigned URL (use if bucket is private)
B2_USE_PRESIGNED_URL=false
B2_PRESIGN_EXPIRES_SECONDS=604800
