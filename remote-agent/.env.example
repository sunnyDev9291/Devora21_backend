# Devora21 API base (no trailing slash required)
API_BASE_URL=https://api.devora21.com

# Device secret from POST /resume/remote-devices (shown once as rawSecret)
# Example: dvrd_xxxxxxxx...
DEVICE_SECRET=

# Where files are saved on this PC
SAVE_DIR=

# Poll interval in milliseconds (default 5000)
POLL_INTERVAL_MS=5000

# Optional: overwrite existing files with the same name (true/false, default true)
OVERWRITE=true
